APP_ENV="local"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Email Provider Choice: "mailtrap" or "gmail"
EMAIL_PROVIDER="mailtrap"

# Mailtrap SMTP Host/Port (only used when EMAIL_PROVIDER="mailtrap")
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525

# Shared SMTP Credentials
SMTP_USER="your_username_or_email"
SMTP_PASS="your_password_or_app_password"

# Common SMTP Settings
SMTP_FROM="Your Company Name <your_email@gmail.com>"
ADMIN_EMAIL="your_email@gmail.com"

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"